# Copy to .env and edit. Teammates on other laptops point these at the server laptop.
# 1 = use MongoDB (docker compose up -d, then python backend/load_data.py). 0 = local JSON files, no database.
USE_MONGO=0
MONGO_URI=mongodb://localhost:27017/?directConnection=true
MONGO_DB=skyclear
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
EMBED_MODEL=nomic-embed-text
USE_LLM=0

# Demo authority account (seeded on startup). Change for any shared deployment.
OFFICIAL_EMAIL=official@skyclear.demo
OFFICIAL_PASSWORD=skyclear-demo
OFFICIAL_NAME=Hyderabad Airspace Desk
