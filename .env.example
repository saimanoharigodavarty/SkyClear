# Copy to .env and edit. run.sh does this for you.
# Secrets (JWT_SECRET, PERMIT_SECRET) are generated on first start and kept in data/.secrets.json, which is git-ignored.
# To use your own, set them here. Never commit real values.

# 1 = MongoDB (docker compose up -d, then python backend/load_data.py). 0 = local JSON files, no database.
USE_MONGO=0
MONGO_URI=mongodb://localhost:27017/?directConnection=true
MONGO_DB=skyclear

# Where one-time codes go. OTP_CHANNEL: email or sms. OTP_PROVIDER: console (server log), smtp (email), twilio (SMS).
OTP_CHANNEL=email
OTP_PROVIDER=console
# SMTP Settings:
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 (or 465 with SMTP_USE_SSL=1), SMTP_USER=your_email@gmail.com,
# SMTP_PASSWORD=your_16_char_google_app_password (generate at myaccount.google.com -> Security -> 2-Step -> App Passwords).
# For local mail catcher (docker compose): SMTP_HOST=localhost, SMTP_PORT=1025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SkyClear <no-reply@skyclear.local>
SMTP_USE_SSL=0
SMTP_TIMEOUT=10
# SMS through Twilio (only when OTP_PROVIDER=twilio and OTP_CHANNEL=sms)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# 1 makes officials use an authenticator app when they sign in.
REQUIRE_OFFICIAL_MFA=0

# Explanations (Ollama on another laptop)
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
EMBED_MODEL=nomic-embed-text
USE_LLM=0

# Optional Mappls place-search proxy. Keep the real static key in .env only;
# the backend uses it and never sends it to the browser.
MAPPLS_API_KEY=

# Google Authentication (OAuth 2.0 Web Client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=   # optional, see docs/GOOGLE_SIGNIN.md
